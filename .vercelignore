# Vercel ignore patterns

# Database files (use PostgreSQL on Vercel)
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# Testing
tests/

# Documentation
docs/

# Docker files (not needed on Vercel)
Dockerfile
docker-compose.yml
.dockerignore

# Local config
.env.local
config/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

