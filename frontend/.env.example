# =============================================================================
# Nexar AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# =============================================================================

# -----------------------------------------------------------------------------
# NextAuth.js
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# LLM Providers — at least one is required for grant discovery & analysis
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Set to "openai" (default) or "anthropic"
LLM_PROVIDER=openai

# -----------------------------------------------------------------------------
# Upstash Redis (replaces Vercel KV)
# Connect via: Vercel dashboard → Integrations → Upstash → Redis
# Or create a free database at https://upstash.com and copy the REST credentials.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Email — Resend (https://resend.com — free tier: 100 emails/day)
# Used for grant deadline alert notifications.
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Cron Security
# Generate with: openssl rand -base64 32
# Vercel automatically sends this as "Authorization: Bearer <CRON_SECRET>"
# for cron job invocations.
# -----------------------------------------------------------------------------
CRON_SECRET=generate-with-openssl-rand-base64-32

# -----------------------------------------------------------------------------
# Optional / Debug
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_NAME=Nexar-AI
# NEXT_PUBLIC_DEBUG=false
