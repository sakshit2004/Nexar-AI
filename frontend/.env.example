# Frontend Environment Variables

# Optional: Set when using external Python backend (default: same-origin Next.js API routes)
# NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_APP_NAME=Nexar-AI
NEXT_PUBLIC_APP_VERSION=1.0.0

# Required for grant discovery (Next.js API routes or Vercel)
# Add to .env.local — at least one is required
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# LLM_PROVIDER=openai