# Nexar-AI - Git Ignore

# Environment variables (CRITICAL - DO NOT COMMIT)
.env
.env.*
!.env.example
!**/.env.example
.env.local
.env.*.local
*.env
!*.env.example

# Vercel (ignore local .vercel folder only; vercel.json is committed for rewrites/serverless)
.vercel

# Python / virtual environments (ignore if present)
venv/
.venv/
ENV/
env/
__pycache__/
*.py[cod]
*.pyc
.Python

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Database files
*.db
*.sqlite
*.sqlite3
grantmatch.db

# Logs
*.log
logs/
*.log.*

# Jupyter Notebook
.ipynb_checkpoints

# Streamlit
.streamlit/secrets.toml

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.cache

# OS files
Thumbs.db
.DS_Store

# Node.js / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/package-lock.json

